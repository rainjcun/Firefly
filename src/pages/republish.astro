---
// ============================================
// 转载文章页面
// ============================================
// 页面路径: /republish/
// 功能:
//   1. 输入文章链接，一键转载到本地博客
//   2. 显示所有已转载的文章列表
// ============================================

// 导入依赖模块
import { Icon } from "astro-icon/components";           // 图标组件
import I18nKey from "@i18n/i18nKey";                    // 多语言键名
import { i18n } from "@i18n/translation";                // 多语言翻译函数
import MainGridLayout from "@layouts/MainGridLayout.astro"; // 主布局组件
import { getSortedPostsList } from "@/utils/content-utils";  // 获取文章列表工具函数
import { url } from "@/utils/url-utils";                     // URL 生成工具函数

// 获取所有文章，并筛选出带"转载"或"repost"标签的文章
const allPosts = await getSortedPostsList();
const republishPosts = allPosts.filter(post => 
  post.data.tags && post.data.tags.some(tag => tag === "转载" || tag === "repost")
);
---

<!-- 页面主体，使用主布局 -->
<MainGridLayout title={i18n(I18nKey.republishTitle)}>
  <div class="max-w-2xl mx-auto">
    <!-- 转载工具卡片 -->
    <div class="card card-hover scale-animation mb-8">
      <div class="p-6">
        <!-- 标题区域 -->
        <h2 class="text-xl font-bold mb-4 flex items-center gap-2">
          <Icon name="material-symbols:link" is:inline class="text-(--primary)" />
          {i18n(I18nKey.republishLinkInput)}
        </h2>
        <p class="text-gray-500 dark:text-gray-400 mb-6 text-sm">
          {i18n(I18nKey.republishDescription)}
        </p>
        
        <!-- 输入框和按钮 -->
        <div class="flex flex-col sm:flex-row gap-3">
          <input
            type="url"
            id="republish-url"
            placeholder={i18n(I18nKey.republishLinkPlaceholder)}
            class="flex-1 px-4 py-3 rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-(--primary) focus:border-transparent transition"
          />
          <button
            id="republish-btn"
            class="px-6 py-3 bg-(--primary) hover:bg-(--primary-dark) text-white font-medium rounded-lg transition flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed"
          >
            <Icon name="material-symbols:download" is:inline />
            {i18n(I18nKey.republishSubmit)}
          </button>
        </div>
        
        <!-- 进度条容器 (默认隐藏) -->
        <div id="progress-container" class="mt-6 hidden">
          <div class="flex items-center gap-3 mb-2">
            <div id="progress-icon" class="w-5 h-5 flex items-center justify-center">
              <Icon name="svg-spinners:ring-resize" is:inline class="text-blue-500" />
            </div>
            <span id="progress-text" class="text-sm text-gray-600 dark:text-gray-400">处理中...</span>
          </div>
          <div class="h-2 bg-gray-200 dark:bg-gray-700 rounded-full overflow-hidden">
            <!-- 进度条，JavaScript 动态修改 width 属性 -->
            <div id="progress-bar" class="h-full bg-(--primary) transition-all duration-300 ease-out" style="width: 0%"></div>
          </div>
        </div>
        
        <!-- 成功提示容器 (默认隐藏) -->
        <div id="success-container" class="mt-6 hidden">
          <div class="flex items-center gap-2 mb-3">
            <div class="w-6 h-6 rounded-full bg-green-100 dark:bg-green-900/30 flex items-center justify-center">
              <Icon name="material-symbols:check" is:inline class="text-green-600 dark:text-green-400" />
            </div>
            <span class="font-semibold text-green-600 dark:text-green-400">Markdown 已生成！</span>
          </div>

          <!-- 文章标题 -->
          <p id="success-title" class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-3"></p>

          <!-- Markdown 预览区域 -->
          <div class="mb-3">
            <label class="block text-xs text-gray-500 dark:text-gray-400 mb-1">预览：</label>
            <pre id="markdown-preview" class="max-h-64 overflow-auto p-3 bg-gray-50 dark:bg-gray-900 rounded-lg border border-gray-200 dark:border-gray-700 text-xs text-gray-700 dark:text-gray-300 font-mono whitespace-pre-wrap break-words"></pre>
          </div>

          <!-- 操作按钮 -->
          <div class="flex flex-wrap gap-2 mb-3">
            <button
              id="download-btn"
              class="inline-flex items-center gap-2 px-4 py-2 bg-(--primary) hover:bg-(--primary-dark) text-white text-sm rounded-lg transition"
            >
              <Icon name="material-symbols:download" is:inline />
              下载 .md 文件
            </button>
            <button
              id="copy-btn"
              class="inline-flex items-center gap-2 px-4 py-2 bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300 text-sm rounded-lg transition"
            >
              <Icon name="material-symbols:content-copy" is:inline />
              复制到剪贴板
            </button>
          </div>

          <!-- 使用提示 -->
          <p class="text-xs text-gray-500 dark:text-gray-400">
            下载后将文件保存到项目的 <code class="bg-gray-200 dark:bg-gray-800 px-1 rounded">src/content/posts/republish/</code> 目录，然后提交到 GitHub 即可自动部署。
          </p>
        </div>
        
        <!-- 错误提示容器 (默认隐藏) -->
        <div id="republish-error" class="mt-6 hidden p-4 bg-red-50 dark:bg-red-900/20 rounded-lg border border-red-200 dark:border-red-800">
          <p class="text-red-600 dark:text-red-400 text-sm">
            请输入有效的文章链接
          </p>
        </div>
      </div>
    </div>
    
    <!-- 转载文章列表卡片 -->
    <div class="card card-hover scale-animation">
      <div class="p-6">
        <h2 class="text-xl font-bold mb-6 flex items-center gap-2">
          <Icon name="material-symbols:article" is:inline class="text-(--primary)" />
          {i18n(I18nKey.republishAllPosts)}
        </h2>
        
        <!-- 如果没有转载文章，显示空状态 -->
        {republishPosts.length === 0 ? (
          <div class="text-center py-12">
            <Icon name="material-symbols:file-open" is:inline class="text-6xl text-gray-300 dark:text-gray-600 mb-4" />
            <p class="text-gray-500 dark:text-gray-400">
              {i18n(I18nKey.republishNoPosts)}
            </p>
          </div>
        ) : (
          <!-- 如果有转载文章，显示文章列表 -->
          <div class="space-y-4">
            {republishPosts.map((post) => (
              <a
                href={url(`/posts/${post.id}/`)}
                class="flex items-start gap-4 p-4 bg-gray-50 dark:bg-gray-800 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition group"
              >
                <!-- 图标 -->
                <div class="flex-shrink-0 w-12 h-12 bg-(--primary) rounded-lg flex items-center justify-center">
                  <Icon name="material-symbols:repeat" is:inline class="text-white" />
                </div>
                <!-- 文章信息 -->
                <div class="flex-1 min-w-0">
                  <h3 class="font-semibold text-gray-900 dark:text-white truncate group-hover:text-(--primary) transition">
                    {post.data.title}
                  </h3>
                  <p class="text-sm text-gray-500 dark:text-gray-400 mt-1 line-clamp-2">
                    {post.data.description}
                  </p>
                  <div class="flex items-center gap-3 mt-2">
                    <span class="text-xs text-gray-400">
                      {new Date(post.data.published).toLocaleDateString("zh-CN")}
                    </span>
                    {post.data.tags && post.data.tags.includes("转载") && (
                      <span class="px-2 py-0.5 bg-orange-100 dark:bg-orange-900/30 text-orange-600 dark:text-orange-400 text-xs rounded">
                        转载
                      </span>
                    )}
                  </div>
                </div>
                <!-- 箭头图标 -->
                <Icon name="material-symbols:chevron-right" is:inline class="text-gray-400 group-hover:text-(--primary) group-hover:translate-x-1 transition" />
              </a>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>
</MainGridLayout>

<!-- 前端 JavaScript 代码 -->
<!-- is:inline 属性让代码直接嵌入 HTML，不依赖外部文件加载 -->
<script is:inline>
  (function() {
    var urlInput = document.getElementById('republish-url');
    var republishBtn = document.getElementById('republish-btn');
    var progressContainer = document.getElementById('progress-container');
    var progressBar = document.getElementById('progress-bar');
    var progressText = document.getElementById('progress-text');
    var successContainer = document.getElementById('success-container');
    var errorDiv = document.getElementById('republish-error');
    var successTitle = document.getElementById('success-title');
    var markdownPreview = document.getElementById('markdown-preview');
    var downloadBtn = document.getElementById('download-btn');
    var copyBtn = document.getElementById('copy-btn');

    if (!urlInput || !republishBtn || !progressContainer || !progressBar || !progressText || !successContainer || !errorDiv) {
      console.error('Republish page elements not found');
      return;
    }

    // 存储当前生成的 markdown 内容和文件名
    var currentMarkdown = '';
    var currentFileName = '';

    function showProgress() {
      progressContainer.classList.remove('hidden');
      successContainer.classList.add('hidden');
      errorDiv.classList.add('hidden');
      republishBtn.disabled = true;
      progressBar.style.width = '0%';
      progressText.textContent = '正在解析链接...';
    }

    function updateProgress(percent, text) {
      progressBar.style.width = percent + '%';
      progressText.textContent = text;
    }

    function showSuccess(data) {
      progressContainer.classList.add('hidden');
      successContainer.classList.remove('hidden');
      republishBtn.disabled = false;
      progressBar.style.width = '100%';

      // 保存 markdown 内容和文件名
      currentMarkdown = data.markdown;
      currentFileName = data.fileName;

      // 显示文章标题
      if (successTitle) {
        successTitle.textContent = '「' + data.title + '」— 作者: ' + data.author;
      }

      // 显示 markdown 预览（截取前 500 字符）
      if (markdownPreview) {
        var previewText = data.markdown.length > 500
          ? data.markdown.substring(0, 500) + '\n\n... (已截断，完整内容请下载)'
          : data.markdown;
        markdownPreview.textContent = previewText;
      }
    }

    function showError(message) {
      progressContainer.classList.add('hidden');
      successContainer.classList.add('hidden');
      errorDiv.classList.remove('hidden');
      errorDiv.querySelector('p').textContent = message;
      republishBtn.disabled = false;
    }

    // 下载按钮点击事件
    if (downloadBtn) {
      downloadBtn.addEventListener('click', function() {
        if (!currentMarkdown || !currentFileName) return;
        var blob = new Blob([currentMarkdown], { type: 'text/markdown;charset=utf-8' });
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = currentFileName;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      });
    }

    // 复制按钮点击事件
    if (copyBtn) {
      copyBtn.addEventListener('click', function() {
        if (!currentMarkdown) return;
        navigator.clipboard.writeText(currentMarkdown).then(function() {
          var originalText = copyBtn.innerHTML;
          copyBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg> 已复制!';
          setTimeout(function() {
            copyBtn.innerHTML = originalText;
          }, 2000);
        }).catch(function() {
          alert('复制失败，请手动选中内容复制');
        });
      });
    }

    // 转载按钮点击事件
    republishBtn.addEventListener('click', function() {
      try {
        var inputUrl = urlInput.value.trim();

        if (!inputUrl) {
          showError('请输入要转载的文章链接');
          return;
        }

        try {
          new URL(inputUrl);
        } catch (e) {
          showError('请输入有效的链接地址');
          return;
        }

        showProgress();

        var progressInterval = setInterval(function() {
          var currentWidth = parseInt(progressBar.style.width) || 0;
          if (currentWidth < 90) {
            progressBar.style.width = (currentWidth + 5) + '%';
          }
        }, 200);

        fetch('/api/republish/', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ url: inputUrl })
        }).then(function(response) {
          clearInterval(progressInterval);
          progressBar.style.width = '100%';
          return response.json();
        }).then(function(result) {
          if (result.success) {
            showSuccess(result.data);
          } else {
            showError(result.message || '转载失败');
          }
        }).catch(function(error) {
          clearInterval(progressInterval);
          showError('网络错误，请稍后重试');
          console.error('Republish API error:', error);
        });

      } catch (err) {
        console.error('Error in republish click handler:', err);
        republishBtn.disabled = false;
        progressContainer.classList.add('hidden');
      }
    });
  })();
</script>
