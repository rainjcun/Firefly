{
  "version": 1,
  "include": [
    "/*"
  ],
  "exclude": [],
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/*",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ],
  "redirects": [],
  "rewrites": [
    {
      "source": "/*",
      "destination": "/index.html"
    }
  ]
}
